<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Paulie's-Style Rigatoni Bolognese</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: #F2EBD9;
font-family: Georgia, ‘Times New Roman’, serif;
color: #2C1A0E;
padding: 0 20px 60px;
}

.topbar {
height: 6px;
background: linear-gradient(90deg, #8B1A1A, #5C3317, #8B1A1A);
margin: 0 -20px 40px;
}

.header {
text-align: center;
padding-bottom: 28px;
border-bottom: 1px solid #D4B896;
margin-bottom: 28px;
}

.eyebrow {
font-size: 11px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: #8B1A1A;
margin-bottom: 12px;
display: block;
}

h1 {
font-size: 36px;
line-height: 1.15;
color: #2C1A0E;
font-weight: 700;
margin-bottom: 10px;
}

.subtitle {
font-style: italic;
font-size: 17px;
color: #8C7055;
margin-bottom: 24px;
}

.divider {
color: #D4B896;
font-size: 18px;
letter-spacing: 8px;
margin-bottom: 20px;
display: block;
}

.meta-bar {
display: flex;
align-items: center;
justify-content: center;
gap: 24px;
}

.meta-item {
display: flex;
flex-direction: column;
align-items: center;
gap: 3px;
}

.meta-label {
font-size: 10px;
letter-spacing: 0.15em;
text-transform: uppercase;
color: #8C7055;
}

.meta-value {
font-size: 15px;
font-weight: 700;
color: #5C3317;
}

.meta-divider {
width: 1px;
height: 28px;
background: #D4B896;
}

.serving-row {
display: flex;
align-items: center;
gap: 10px;
}

.btn {
width: 30px;
height: 30px;
border-radius: 50%;
border: 1.5px solid #8B1A1A;
background: #F2EBD9;
font-size: 20px;
color: #8B1A1A;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
-webkit-appearance: none;
appearance: none;
line-height: 1;
padding: 0;
font-family: Georgia, serif;
}

.btn:active {
background: #8B1A1A;
color: #F2EBD9;
}

#serving-count {
font-size: 26px;
font-weight: 700;
color: #8B1A1A;
min-width: 36px;
text-align: center;
display: block;
}

.section-label {
font-size: 10px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: #8B1A1A;
margin-bottom: 14px;
display: flex;
align-items: center;
gap: 10px;
}

.section-label::after {
content: ‘’;
flex: 1;
height: 1px;
background: #D4B896;
}

.ingredients {
list-style: none;
margin-bottom: 36px;
}

.ingredients li {
display: flex;
gap: 12px;
padding: 8px 0;
border-bottom: 1px solid rgba(212,184,150,0.35);
font-size: 16px;
line-height: 1.4;
}

.ingredients li:last-child { border-bottom: none; }

.amt {
font-weight: 700;
color: #8B1A1A;
min-width: 60px;
flex-shrink: 0;
}

.steps { list-style: none; margin-bottom: 36px; }

.step {
display: flex;
gap: 16px;
margin-bottom: 20px;
}

.step-n {
font-size: 20px;
font-weight: 700;
color: #8B1A1A;
opacity: 0.6;
min-width: 22px;
padding-top: 1px;
}

.step-title {
font-size: 14px;
font-weight: 700;
color: #5C3317;
margin-bottom: 4px;
text-transform: uppercase;
letter-spacing: 0.04em;
}

.step-text {
font-size: 16px;
line-height: 1.6;
}

.notes { margin-top: 8px; }

.note {
border-left: 2px solid #D4B896;
padding-left: 14px;
margin-bottom: 16px;
font-size: 14px;
line-height: 1.5;
color: #8C7055;
}

.note strong {
display: block;
font-size: 11px;
letter-spacing: 0.08em;
text-transform: uppercase;
color: #5C3317;
margin-bottom: 2px;
}

.footer {
text-align: center;
margin-top: 40px;
padding-top: 18px;
border-top: 1px solid #D4B896;
font-size: 12px;
color: #D4B896;
letter-spacing: 0.1em;
}

/* Mode selector buttons */
.mode-selector {
display: flex;
gap: 10px;
margin-bottom: 28px;
}

.mode-btn {
flex: 1;
padding: 12px 10px;
border-radius: 10px;
border: 1.5px solid #D4B896;
background: #EDE4D0;
cursor: pointer;
text-align: center;
-webkit-appearance: none;
appearance: none;
transition: background 0.2s, border-color 0.2s;
font-family: Georgia, ‘Times New Roman’, serif;
}

.mode-btn .btn-title {
display: block;
font-size: 14px;
font-weight: 700;
letter-spacing: 0.08em;
text-transform: uppercase;
color: #8C7055;
margin-bottom: 4px;
}

.mode-btn .btn-macros {
display: block;
font-size: 11px;
color: #B09070;
line-height: 1.5;
}

.mode-btn.active-classic {
background: #5C3317;
border-color: #5C3317;
}

.mode-btn.active-classic .btn-title {
color: #F2EBD9;
}

.mode-btn.active-classic .btn-macros {
color: #D4B896;
}

.mode-btn.active-healthy {
background: #2E5C3A;
border-color: #2E5C3A;
}

.mode-btn.active-healthy .btn-title {
color: #F2EBD9;
}

.mode-btn.active-healthy .btn-macros {
color: #A8D4B0;
}

.mode-classic { display: block; }
.mode-healthy { display: none; }

body.healthy .mode-classic { display: none; }
body.healthy .mode-healthy { display: block; }

body.healthy .topbar {
background: linear-gradient(90deg, #4A7C59, #2E5C3A, #4A7C59);
}

body.healthy .eyebrow,
body.healthy .section-label,
body.healthy .step-n,
body.healthy .amt,
body.healthy #serving-count,
body.healthy .btn {
color: #4A7C59;
}

body.healthy .btn {
border-color: #4A7C59;
background: #F2EBD9;
}

body.healthy .btn:active {
background: #4A7C59;
color: #F2EBD9;
}

body.healthy .step-title,
body.healthy .meta-value,
body.healthy .note strong {
color: #2E5C3A;
}
</style>

</head>
<body>

<div class="topbar"></div>

<div class="header">
  <span class="eyebrow">In Memory of Montrose's Finest</span>
  <h1>Paulie's-Style Rigatoni Bolognese</h1>
  <p class="subtitle">A faithful recreation of the iconic Houston classic</p>
  <span class="divider">&#8212; &#8212; &#8212;</span>
  <div class="meta-bar">
    <div class="meta-item">
      <span class="meta-label">Serves</span>
      <div class="serving-row">
        <button class="btn" id="btn-down">&#8722;</button>
        <span id="serving-count">4</span>
        <button class="btn" id="btn-up">&#43;</button>
      </div>
      <span class="meta-label">people</span>
    </div>
    <div class="meta-divider"></div>
    <div class="meta-item">
      <span class="meta-label">Active</span>
      <span class="meta-value">~30 min</span>
    </div>
    <div class="meta-divider"></div>
    <div class="meta-item">
      <span class="meta-label">Total</span>
      <span class="meta-value">~2.5 hrs</span>
    </div>
  </div>
</div>

<div class="mode-selector">
  <button class="mode-btn active-classic" id="btn-classic">
    <span class="btn-title">Classic</span>
    <span class="btn-macros">~680 cal &bull; 35g protein<br>52g carbs &bull; 28g fat</span>
  </button>
  <button class="mode-btn" id="btn-healthy">
    <span class="btn-title">Healthy</span>
    <span class="btn-macros">~540 cal &bull; 42g protein<br>52g carbs &bull; 14g fat</span>
  </button>
</div>

<div class="section-label">Ingredients</div>
<ul class="ingredients" id="ing-list"></ul>

<div class="section-label">Instructions</div>

<ol class="steps mode-classic">
  <li class="step"><span class="step-n">1</span><div><div class="step-title">Build the soffritto</div><p class="step-text">Heat olive oil and butter in a large Dutch oven over medium heat. Add onion, carrots, and celery. Cook, stirring often, until very soft and golden, about 10 minutes. Add garlic and cook 1 more minute.</p></div></li>
  <li class="step"><span class="step-n">2</span><div><div class="step-title">Brown the meat</div><p class="step-text">Add ground beef and veal. Break up as finely as possible — the smaller the crumble, the better it clings to pasta. Cook until no longer pink, 6–8 minutes. Season generously with salt and pepper.</p></div></li>
  <li class="step"><span class="step-n">3</span><div><div class="step-title">Add milk</div><p class="step-text">Pour in the whole milk and stir. Cook until fully absorbed, about 5 minutes. This tenderizes the meat and adds richness.</p></div></li>
  <li class="step"><span class="step-n">4</span><div><div class="step-title">Deglaze with wine</div><p class="step-text">Add red wine and scrape up any browned bits from the bottom. Cook until mostly absorbed, about 5 minutes.</p></div></li>
  <li class="step"><span class="step-n">5</span><div><div class="step-title">Simmer the sauce</div><p class="step-text">Stir in crushed tomatoes. Bring to a boil then reduce to low. Simmer partially covered for 1 hour, then uncovered for 30 more minutes. Sauce should be thick, not runny.</p></div></li>
  <li class="step"><span class="step-n">6</span><div><div class="step-title">Finish with cream</div><p class="step-text">Stir in heavy cream and Parmesan. Taste and adjust seasoning.</p></div></li>
  <li class="step"><span class="step-n">7</span><div><div class="step-title">Cook the pasta</div><p class="step-text">Cook rigatoni in well-salted boiling water until just al dente (1–2 min less than package). Reserve 1 cup pasta water before draining.</p></div></li>
  <li class="step"><span class="step-n">8</span><div><div class="step-title">Marry pasta and sauce</div><p class="step-text">Add drained rigatoni to the sauce over medium-low heat. Toss well, adding pasta water as needed so the sauce clings to every ridge. Cook together 1–2 minutes.</p></div></li>
  <li class="step"><span class="step-n">9</span><div><div class="step-title">Serve</div><p class="step-text">Plate and top with fresh basil, parsley, and extra Parmesan. Serve immediately.</p></div></li>
</ol>

<ol class="steps mode-healthy">
  <li class="step"><span class="step-n">1</span><div><div class="step-title">Build the soffritto</div><p class="step-text">Heat olive oil and both tablespoons of butter in a large Dutch oven over medium heat. Add onion, carrots, and celery. Cook until very soft and golden, about 10 minutes. Add garlic and tomato paste, cook 1–2 more minutes until paste darkens slightly.</p></div></li>
  <li class="step"><span class="step-n">2</span><div><div class="step-title">Brown the turkey</div><p class="step-text">Add ground turkey. Use a hot pan and don't stir too early — let it sit and actually brown before breaking it up. Cook in batches if needed to avoid steaming. Season generously with salt, pepper, and a pinch of nutmeg.</p></div></li>
  <li class="step"><span class="step-n">3</span><div><div class="step-title">Add milk</div><p class="step-text">Pour in the whole milk and stir. Cook until fully absorbed, about 5 minutes. This step is especially important with turkey — it tenderizes the lean meat and adds the creaminess it naturally lacks.</p></div></li>
  <li class="step"><span class="step-n">4</span><div><div class="step-title">Deglaze with wine</div><p class="step-text">Add red wine and scrape up any browned bits. Cook until mostly absorbed, about 5 minutes.</p></div></li>
  <li class="step"><span class="step-n">5</span><div><div class="step-title">Simmer the sauce</div><p class="step-text">Stir in crushed tomatoes and drop in the Parmesan rind if using. Bring to a boil then reduce to low. Simmer partially covered for 1 hour, then uncovered for 30 more minutes. Remove rind before serving.</p></div></li>
  <li class="step"><span class="step-n">6</span><div><div class="step-title">Finish with cream</div><p class="step-text">Stir in the heavy cream and grated Parmesan. Taste and adjust seasoning. The cream is slightly increased here to compensate for the leaner meat.</p></div></li>
  <li class="step"><span class="step-n">7</span><div><div class="step-title">Cook the pasta</div><p class="step-text">Cook rigatoni in well-salted boiling water until just al dente (1–2 min less than package). Reserve 1 cup pasta water before draining.</p></div></li>
  <li class="step"><span class="step-n">8</span><div><div class="step-title">Marry pasta and sauce</div><p class="step-text">Add drained rigatoni to the sauce over medium-low heat. Toss well, adding pasta water as needed. Cook together 1–2 minutes.</p></div></li>
  <li class="step"><span class="step-n">9</span><div><div class="step-title">Serve</div><p class="step-text">Plate and top with fresh basil, parsley, and extra Parmesan. Serve immediately.</p></div></li>
</ol>

<div class="section-label">Notes &amp; Tips</div>
<div class="notes mode-classic">
  <div class="note"><strong>The pasta secret</strong>Look for bronze-die-cut rigatoni ("trafilata al bronzo") — the rough surface grabs sauce like fresh pasta. Rustichella d'Abruzzo is a great brand.</div>
  <div class="note"><strong>Make ahead</strong>The bolognese is better the next day. Make the sauce ahead and reheat gently before cooking your pasta.</div>
  <div class="note"><strong>Veal substitute</strong>Can't find ground veal? Use half beef, half ground pork for similar richness.</div>
  <div class="note"><strong>Wine tip</strong>Use a dry red you'd drink — Chianti is the classic. A $12–15 bottle is perfect.</div>
  <div class="note"><strong>Covered vs. uncovered</strong>Simmer partially covered for the first hour, then uncovered for the last 30 minutes to thicken.</div>
</div>
<div class="notes mode-healthy">
  <div class="note"><strong>Brown don't steam</strong>Turkey releases a lot of water. Cook on high heat and don't crowd the pan — browning is essential for flavor.</div>
  <div class="note"><strong>Tomato paste is key</strong>Adding tomato paste with the garlic deepens the umami that lean turkey can't provide on its own.</div>
  <div class="note"><strong>Parmesan rind trick</strong>Drop a rind into the simmering sauce — it melts in and adds deep savory richness with no extra fat.</div>
  <div class="note"><strong>Don't skip the milk</strong>Even more important here than in the classic version. It tenderizes the turkey and rounds out the flavor.</div>
  <div class="note"><strong>Wine tip</strong>Chianti still works great. The acidity balances the lighter meat nicely.</div>
</div>

<div class="footer">&#10086; &nbsp; Paulie's Restaurant &nbsp;&#183;&nbsp; Houston, TX &nbsp;&#183;&nbsp; 1998–2025 &nbsp; &#10086;</div>

<script>
const BASE = 4;

const classicIng = [
  [1, 'lb', 'rigatoni (bronze-die-cut dried or fresh)'],
  [0.5, 'lb', 'ground beef (80/20)'],
  [0.5, 'lb', 'ground veal (or ground pork)'],
  [1, '', 'yellow onion, finely diced'],
  [2, '', 'carrots, finely diced'],
  [2, '', 'celery stalks, finely diced'],
  [4, '', 'garlic cloves, minced'],
  [2, 'tbsp', 'olive oil'],
  [1, 'tbsp', 'unsalted butter'],
  [0.5, 'cup', 'dry red wine (Chianti recommended)'],
  [0.5, 'cup', 'whole milk'],
  [1, 'can (28 oz)', 'crushed San Marzano tomatoes'],
  [0.25, 'cup', 'heavy cream'],
  [0.25, 'cup', 'fresh basil, torn'],
  [2, 'tbsp', 'fresh parsley, chopped'],
  [0.5, 'cup', 'Parmesan, freshly grated (plus more to serve)'],
  [0, '', 'kosher salt and black pepper'],
];

const healthyIng = [
  [1, 'lb', 'rigatoni (bronze-die-cut dried or fresh)'],
  [1, 'lb', 'ground turkey (93% lean)'],
  [1, '', 'yellow onion, finely diced'],
  [2, '', 'carrots, finely diced'],
  [2, '', 'celery stalks, finely diced'],
  [4, '', 'garlic cloves, minced'],
  [1, 'tbsp', 'tomato paste'],
  [2, 'tbsp', 'olive oil'],
  [2, 'tbsp', 'unsalted butter'],
  [0.5, 'cup', 'dry red wine (Chianti recommended)'],
  [0.5, 'cup', 'whole milk'],
  [1, 'can (28 oz)', 'crushed San Marzano tomatoes'],
  [0.333, 'cup', 'heavy cream'],
  [1, '', 'Parmesan rind (optional, for simmering)'],
  [0.25, 'cup', 'fresh basil, torn'],
  [2, 'tbsp', 'fresh parsley, chopped'],
  [0.5, 'cup', 'Parmesan, freshly grated (plus more to serve)'],
  [0, '', 'kosher salt, black pepper, pinch of nutmeg'],
];

let servings = 4;
let healthy = false;

function fmt(base) {
  const n = (base / BASE) * servings;
  if (n === 0) return '';
  const fracs = [[0.125,'1/8'],[0.25,'1/4'],[0.333,'1/3'],[0.5,'1/2'],[0.667,'2/3'],[0.75,'3/4']];
  const whole = Math.floor(n);
  const rem = n - whole;
  for (const [v, s] of fracs) {
    if (Math.abs(rem - v) < 0.05) return whole > 0 ? whole + ' ' + s : s;
  }
  const r = Math.round(n * 10) / 10;
  return r % 1 === 0 ? String(r) : String(r);
}

function render() {
  const ing = healthy ? healthyIng : classicIng;
  document.getElementById('ing-list').innerHTML = ing.map(function(row) {
    var a = row[0], u = row[1], n = row[2];
    var amt = a === 0 ? 'to taste' : fmt(a) + (u ? ' ' + u : '');
    return '<li><span class="amt">' + amt + '</span><span>' + n + '</span></li>';
  }).join('');
  document.getElementById('serving-count').textContent = servings;
}

document.getElementById('btn-up').onclick = function() { servings = Math.min(20, servings + 1); render(); };
document.getElementById('btn-down').onclick = function() { servings = Math.max(1, servings - 1); render(); };

document.getElementById('btn-classic').onclick = function() {
  healthy = false;
  document.body.classList.remove('healthy');
  document.getElementById('btn-classic').className = 'mode-btn active-classic';
  document.getElementById('btn-healthy').className = 'mode-btn';
  render();
};

document.getElementById('btn-healthy').onclick = function() {
  healthy = true;
  document.body.classList.add('healthy');
  document.getElementById('btn-classic').className = 'mode-btn';
  document.getElementById('btn-healthy').className = 'mode-btn active-healthy';
  render();
};

render();
</script>

</body>
</html>